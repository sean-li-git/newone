{
  "name": "offer-advisor",
  "version": "1.0.0",
  "description": "Offer审批助手 - 面向薪酬HR的个人提效工具（完全离线）",
  "main": "main.js",
  "author": "OfferAdvisor",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build-web": "node web/build.js"
  },
  "build": {
    "appId": "com.offer-advisor.app",
    "productName": "Offer审批助手",
    "afterPack": "./afterPack.js",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "icon.png",
      "identity": null,
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Offer审批助手",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "files": [
      "main.js",
      "index.html",
      "icon.png",
      "afterPack.js"
    ]
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  }
}
